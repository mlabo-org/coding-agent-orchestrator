{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-agent-orchestrator/coding-agent-orchestrator-input/v1",
  "title": "Coding Agent Orchestrator state-control input",
  "description": "An explicitly activated coding objective bound to an exact Codex root thread and deterministic .CAO state transition.",
  "type": "object",
  "required": [
    "activation",
    "objective",
    "workspaceRoot",
    "rootThreadId",
    "stateTransition"
  ],
  "properties": {
    "activation": {
      "type": "string",
      "description": "The explicit current-user selection of CAO or explicit continuation of an active CAO workflow.",
      "enum": [
        "explicit-cao-prefix",
        "explicit-dollar-skill",
        "explicit-bundled-skill",
        "explicit-plugin-workflow",
        "active-workflow-continuation"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "rootThreadId": {
      "type": "string",
      "description": "The exact current Codex root thread identifier used to isolate state and descendant events from unrelated sessions.",
      "minLength": 1
    },
    "stateTransition": {
      "type": "string",
      "enum": [
        "continue-related",
        "initialize-unrelated"
      ]
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "requestedScope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
