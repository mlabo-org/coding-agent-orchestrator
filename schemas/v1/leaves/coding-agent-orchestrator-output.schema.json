{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-agent-orchestrator/coding-agent-orchestrator-output/v1",
  "title": "Coding Agent Orchestrator state-control output",
  "description": "A completed native Codex coding result with finalized exact-thread .CAO state.",
  "type": "object",
  "required": [
    "status",
    "summary",
    "changedPaths",
    "acceptanceEvidence",
    "externalEffects",
    "unresolvedRisks",
    "workflowState"
  ],
  "properties": {
    "status": {
      "const": "completed"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changedPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "result",
          "detail"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "not-applicable"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "externalEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "status",
          "detail"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "completed",
              "not-requested",
              "not-applicable"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "unresolvedRisks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workflowState": {
      "type": "object",
      "description": "The finalized semantic state plus separately reconciled runtime-observation integrity.",
      "required": [
        "path",
        "taskId",
        "epoch",
        "rootThreadId",
        "finalized",
        "integrity",
        "runtimeObservationIntegrity"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "(^|/)\\.CAO/?$"
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "rootThreadId": {
          "type": "string",
          "minLength": 1
        },
        "finalized": {
          "const": true
        },
        "integrity": {
          "const": "passed"
        },
        "runtimeObservationIntegrity": {
          "description": "Whether exact runtime ancestry was reconciled or no runtime events existed; this does not prove semantic completion.",
          "enum": [
            "reconciled",
            "no-runtime-events"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
